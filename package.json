{
	"name": "lfm-encoder",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun run --filter '@lfm-encoder/*' build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --build --force",
		"test": "bun test packages/*/test/unit",
		"test:integration": "bun test packages/*/test/integration",
		"export": "PYTHONPATH=tools/export python3 -m lfm_export --out models",
		"dev": "bun run --filter '@lfm-encoder/demo' dev",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "bun run build && changeset publish",
		"export:check": "PYTHONPATH=tools/export python3 -m lfm_export.check --out models",
		"parity": "bun run --filter @lfm-encoder/tasks parity",
		"bench": "bun run --filter @lfm-encoder/tasks bench"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@changesets/cli": "^2.29.8",
		"@huggingface/transformers": "^4.2.0",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	}
}
